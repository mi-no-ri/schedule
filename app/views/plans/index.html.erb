<h1>スケジュール管理アプリ</h1>
<div class="wrap">    
    <div class="box" id="top">
        <h2>予定一覧</h2>
        <%= link_to "新規追加", :new_plan, class: "button" %>
    </div>
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>タイトル</th>
                <th>開始日</th>
                <th>終了日</th>
                <th>終日</th>
                <th>更新日時</th>
            </tr>
        </thead>

        <tbody>
            <% @plans.each do |plan| %>
                <tr>
                    <td><%= plan.id %></td>
                    <td><%= plan.name %></td>
                    <td><%= plan.start %></td>
                    <td><%= plan.end %></td>
                    <td>
                        <% if plan.all_day %>
                        〇
                        <% end %>
                    </td>
                    <td><%= plan.updated_at %></td>
                    <td><%= link_to "詳細", plan %></td>
                    </tr>
            <% end %>
        </thead>
    </table>
</div>